{
    "name": "pulsedeck",
    "productName": "PulseDeck",
    "version": "0.6.3",
    "description": "A local soundboard, microphone mixer, voice changer, and replay buffer for Mac and Windows",
    "main": "main.cjs",
    "author": "Isaac Hollow Horn Bear",
    "license": "MIT",
    "homepage": "https://github.com/IsaacHHB/pulsedeck",
    "repository": {
        "type": "git",
        "url": "https://github.com/IsaacHHB/pulsedeck.git"
    },
    "scripts": {
        "start": "electron .",
        "test": "node --test tests/library.test.cjs tests/platform.test.cjs tests/replay-buffer.test.cjs tests/limiter.test.cjs && node tests/voice-effects.cjs && node tests/integration.cjs",
        "icon": "node make-icon.cjs",
        "dist": "node make-icon.cjs && electron-builder --win",
        "dist:publish": "electron-builder --win --publish always",
        "package": "node make-icon.cjs && node build.mjs",
        "dist:mac": "node make-icon.cjs && electron-builder --mac --arm64",
        "dist:mac:local": "node make-icon.cjs && electron-builder --config electron-builder.local.cjs --mac --arm64 --publish never",
        "test:package": "node tests/package-smoke.cjs"
    },
    "dependencies": {
        "electron-updater": "^6.3.9"
    },
    "devDependencies": {
        "@electron/packager": "20.3.0",
        "electron": "44.3.0",
        "electron-builder": "^26.0.12",
        "lamejs": "1.2.1",
        "playwright": "1.63.0"
    },
    "build": {
        "appId": "dev.thelakotadev.pulsedeck",
        "productName": "PulseDeck",
        "copyright": "Copyright © 2026 Isaac Hollow Horn Bear",
        "directories": {
            "output": "dist"
        },
        "files": [
            "*.cjs",
            "*.js",
            "*.html",
            "*.css",
            "*.json",
            "icon.ico",
            "!build.mjs",
            "!make-icon.cjs",
            "!tests/**",
            "!test-results/**",
            "!PulseDeck Data/**",
            "!dist/**",
            "!release/**",
            "icon.png",
            "!electron-builder.local.cjs"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "icon.ico",
            "artifactName": "${productName}-Portable.${ext}",
            "requestedExecutionLevel": "asInvoker"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "artifactName": "${productName}-Setup.${ext}",
            "shortcutName": "PulseDeck",
            "deleteAppDataOnUninstall": false
        },
        "publish": [
            {
                "provider": "github",
                "owner": "IsaacHHB",
                "repo": "pulsedeck",
                "releaseType": "release"
            }
        ],
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "category": "public.app-category.music",
            "icon": "icon.png",
            "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
            "minimumSystemVersion": "14.2",
            "hardenedRuntime": true,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSMicrophoneUsageDescription": "PulseDeck mixes your microphone with voice effects and sounds for calls.",
                "NSAudioCaptureUsageDescription": "PulseDeck keeps recent system audio in the replay buffer so you can save a clip.",
                "NSScreenCaptureUsageDescription": "PulseDeck accesses system audio for the replay buffer. No screen video is saved."
            }
        }
    }
}
